# Copy to .env for local (non-Docker) runs if you want to override defaults.
DATABASE_URL=sqlite:///./chainflow.db
REDIS_URL=redis://localhost:6379/0

# Set ONE of these two -- OpenAI takes priority if both are set. Leaving both
# blank uses the deterministic offline fallback (no external calls).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

OPENAI_API_KEY=
# OpenAI's model lineup changes fast -- check https://platform.openai.com/docs/models
# for the current recommended default and update this if needed.
OPENAI_MODEL=gpt-4o-mini
